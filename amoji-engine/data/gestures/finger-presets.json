        "armR": { "handOpen": 0.95, "fist": 0 },
        "armL": { "fist": 0.15, "handOpen": 0.35 }
      }
    },
    "pinch": {
      "id": "pinch",
      "label": "Pinch",
      "description": "Precision grip staging",
      "gesture": {
        "fist": 0.4,
        "handOpen": 0.15,
        "spread": 0.1,
