      "extends": "upper-body-hands",
      "joints": {
        "middle_L": { "unit": "norm", "min": 0, "max": 1, "rest": 0.15, "region": "hand" },
        "middle_R": { "unit": "norm", "min": 0, "max": 1, "rest": 0.15, "region": "hand" },
        "ring_L": { "unit": "norm", "min": 0, "max": 1, "rest": 0.15, "region": "hand" },
        "ring_R": { "unit": "norm", "min": 0, "max": 1, "rest": 0.15, "region": "hand" },
        "pinky_L": { "unit": "norm", "min": 0, "max": 1, "rest": 0.12, "region": "hand" },
        "pinky_R": { "unit": "norm", "min": 0, "max": 1, "rest": 0.12, "region": "hand" },
        "spread_L": { "unit": "norm", "min": 0, "max": 1, "rest": 0.25, "region": "hand" },
        "spread_R": { "unit": "norm", "min": 0, "max": 1, "rest": 0.25, "region": "hand" }
      }
    }
  },
  "emotionFaceHints": {
    "happy": { "brow": 0.15, "lid": 0.08, "corner": 0.75 },
    "smile_open": { "brow": 0.2, "lid": 0.12, "corner": 0.95, "jaw": 0.35 },
    "sad": { "brow": -0.55, "lid": 0.25, "corner": -0.55 },
    "angry": { "brow": -0.85, "lid": 0.15, "corner": -0.25 },
